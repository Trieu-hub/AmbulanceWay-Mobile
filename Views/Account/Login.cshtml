@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>AmbulanceWay</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            height: 100vh;
            font-family: Arial, sans-serif;
            background: linear-gradient(rgba(253,236,234,0.85), rgba(253,236,234,0.85)),
                        url('/images/benhvien.jpg') no-repeat center / cover;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-box {
            width: 420px;
            background: #fff;
            padding: 32px;
            border-radius: 12px;
            box-shadow: 0 10px 24px rgba(0,0,0,0.15);
        }

        .login-box h2 {
            text-align: center;
            margin-bottom: 16px;
            color: #b71c1c;
        }

        .form-group { margin-bottom: 14px; }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 6px;
        }

        input {
            width: 100%;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }

        button {
            width: 100%;
            margin-top: 18px;
            padding: 12px;
            background: #c62828;
            color: #fff;
            border: none;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
        }

        .error {
            margin-top: 10px;
            text-align: center;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <div class="login-box">
        <h2 class="title">
    AmbulanceWay 
    <span class="spin-icon">🚨</span>
</h2>

        <div class="form-group">
            <label>Tên tài xế</label>
            <input id="hospital">
        </div>

        <div class="form-group">
            <label>Trạm / Đơn vị cấp cứu</label>
            <input id="staff">
        </div>
        
        <div class="form-group">
            <label>Biển số xe</label>
            <input id="vehicle">
        </div>
        <button type="button" onclick="login()">BẮT ĐẦU CA TRỰC</button>

        <p id="msg" class="error"></p>
    </div>

<script>
function login() {

    const driverName = document.getElementById("hospital").value.trim();
    const station = document.getElementById("staff").value.trim();
    const vehicle = document.getElementById("vehicle").value.trim();
    const msg = document.getElementById("msg");

    if (!driverName || !station || !vehicle) {
        msg.style.color = "red";
        msg.innerText = "Vui lòng nhập đầy đủ thông tin!";
        return;
    }

    fetch("/Home/Login", {
        method: "POST",
        headers: {
            "Content-Type": "application/x-www-form-urlencoded"
        },
        body: `driverName=${driverName}&station=${station}&vehicle=${vehicle}`
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            window.location.href = "/Home/Map";
        } else {
            msg.style.color = "red";
            msg.innerText = data.message;
        }
    })
    .catch(error => {
        msg.style.color = "red";
        msg.innerText = "Có lỗi xảy ra!";
        console.log(error);
    });
}
</script>

</body>
</html>