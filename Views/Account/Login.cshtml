@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AmbulanceWay - Đăng nhập</title>
    <meta name="theme-color" content="#0b1220">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --red: #e53935;
            --red-dark: #b71c1c;
            --ink: #0f172a;
            --text: #1e293b;
            --muted: #64748b;
            --border: #e2e8f0;
            --admin: #1e293b;
            --driver: #e53935;
            --patient: #16a34a;
            --hospital: #0284c7;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { min-height: 100vh; font-family: 'Inter', system-ui, sans-serif; color: var(--text); background: #f8fafc; -webkit-font-smoothing: antialiased; }

        .page { min-height: 100vh; display: grid; grid-template-columns: 1.1fr 1fr; }

        /* ---------- Bên trái: giới thiệu ---------- */
        .hero {
            position: relative; overflow: hidden; color: #fff;
            padding: 48px 56px; display: flex; flex-direction: column;
            background:
                linear-gradient(160deg, rgba(11, 18, 32, .92) 0%, rgba(11, 18, 32, .78) 45%, rgba(183, 28, 28, .82) 100%),
                url('/images/benhvien.png') center / cover;
        }
        .hero::after {
            /* vòng sóng "radar" mờ phía sau, gợi tín hiệu SOS */
            content: ''; position: absolute; right: -180px; bottom: -180px; width: 520px; height: 520px; border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, .12);
            box-shadow: 0 0 0 60px rgba(255, 255, 255, .03), 0 0 0 120px rgba(255, 255, 255, .02);
            animation: radar 6s ease-in-out infinite;
        }
        @@keyframes radar { 50% { transform: scale(1.06); } }
        .brand { display: flex; align-items: center; gap: 12px; font-weight: 800; font-size: 1.15rem; letter-spacing: .3px; }
        .brand-mark { width: 44px; height: 44px; border-radius: 13px; display: grid; place-items: center; background: linear-gradient(135deg, #ff5a52, var(--red-dark)); box-shadow: 0 8px 24px rgba(229, 57, 53, .5); }
        .hero-body { margin-top: auto; margin-bottom: auto; max-width: 520px; position: relative; z-index: 1; }
        .eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(255, 255, 255, .1); border: 1px solid rgba(255, 255, 255, .15); font-size: .8rem; font-weight: 600; margin-bottom: 22px; }
        .eyebrow .dot { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 4px rgba(74, 222, 128, .25); }
        .hero h1 { font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1.12; font-weight: 800; letter-spacing: -.02em; }
        .hero h1 span { color: #ff8a84; }
        .hero p.lead { margin-top: 16px; color: #cbd5e1; font-size: 1.05rem; line-height: 1.6; }
        .features { margin-top: 34px; display: grid; gap: 14px; }
        .feature { display: flex; gap: 14px; align-items: flex-start; }
        .feature i { width: 40px; height: 40px; flex-shrink: 0; border-radius: 11px; display: grid; place-items: center; background: rgba(255, 255, 255, .1); color: #fff; }
        .feature b { display: block; font-size: .95rem; }
        .feature small { color: #cbd5e1; font-size: .85rem; }
        .hero-foot { position: relative; z-index: 1; color: #94a3b8; font-size: .8rem; }

        /* ---------- Bên phải: đăng nhập ---------- */
        .side { display: flex; align-items: center; justify-content: center; padding: 40px 24px; }
        .card { width: 100%; max-width: 440px; animation: rise .5s ease; }
        @@keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
        .card h2 { font-size: 1.7rem; font-weight: 800; color: var(--ink); letter-spacing: -.01em; }
        .card .sub { color: var(--muted); margin-top: 6px; margin-bottom: 26px; }

        .tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; padding: 4px; background: #eef2f6; border-radius: 14px; margin-bottom: 26px; position: relative; }
        .tab { border: 0; background: transparent; padding: 10px 6px; border-radius: 11px; font: inherit; font-weight: 600; font-size: .88rem; color: var(--muted); cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: color .2s, background .2s, box-shadow .2s; }
        .tab:hover { color: var(--ink); }
        .tab.active { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(15, 23, 42, .06), 0 4px 12px rgba(15, 23, 42, .08); }
        .tab.active[data-tab="admin"] i { color: var(--admin); }
        .tab.active[data-tab="driver"] i { color: var(--driver); }
        .tab.active[data-tab="patient"] i { color: var(--patient); }
        .tab.active[data-tab="hospital"] i { color: var(--hospital); }
        .hospital-btn { background: linear-gradient(135deg, #0ea5e9, #0369a1); box-shadow: 0 8px 20px rgba(14, 165, 233, .28); }

        .pane { display: none; animation: fade .25s ease; }
        .pane.active { display: block; }
        @@keyframes fade { from { opacity: 0; transform: translateX(6px); } to { opacity: 1; transform: none; } }
        .pane-head { display: flex; align-items: center; gap: 14px; margin-bottom: 20px; }
        .pane-icon { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; font-size: 20px; color: #fff; }
        .pane-head b { display: block; color: var(--ink); font-size: 1.02rem; }
        .pane-head small { color: var(--muted); }

        .field { margin-bottom: 14px; }
        .field label { display: block; font-size: .82rem; font-weight: 600; margin-bottom: 6px; color: var(--text); }
        .input { position: relative; }
        .input i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: .95rem; }
        .input input { width: 100%; padding: 13px 44px 13px 42px; border-radius: 12px; border: 1px solid var(--border); background: #fff; font: inherit; font-size: .95rem; color: var(--ink); transition: border-color .15s, box-shadow .15s; }
        .input input:focus { outline: none; border-color: #fca5a5; box-shadow: 0 0 0 4px rgba(229, 57, 53, .12); }
        .toggle-pass { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); border: 0; background: transparent; width: 34px; height: 34px; border-radius: 9px; color: #94a3b8; cursor: pointer; }
        .toggle-pass:hover { background: #f1f5f9; color: var(--ink); }

        .btn { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 14px; border: 0; border-radius: 12px; font: inherit; font-weight: 700; font-size: .95rem; letter-spacing: .02em; cursor: pointer; color: #fff; text-decoration: none; transition: transform .15s, box-shadow .15s, filter .15s; }
        .btn:hover { transform: translateY(-1px); filter: brightness(1.05); }
        .btn:active { transform: none; }
        .btn[disabled] { opacity: .7; cursor: progress; }
        .admin-btn { background: var(--admin); box-shadow: 0 8px 20px rgba(30, 41, 59, .25); }
        .driver-btn { background: linear-gradient(135deg, #ff5a52, var(--red-dark)); box-shadow: 0 8px 20px rgba(229, 57, 53, .3); }
        .patient-btn { background: linear-gradient(135deg, #22c55e, #15803d); box-shadow: 0 8px 20px rgba(22, 163, 74, .28); }
        .btn-ghost { background: #fff; color: var(--patient); border: 1px solid #bbf7d0; margin-top: 10px; box-shadow: none; }
        .btn-ghost:hover { background: #f0fdf4; }

        .hint { margin-top: 16px; padding: 12px 14px; border-radius: 12px; background: #f8fafc; border: 1px dashed var(--border); color: var(--muted); font-size: .82rem; line-height: 1.5; }
        .hint i { color: #94a3b8; margin-right: 6px; }

        #msg { min-height: 22px; margin-top: 16px; text-align: center; font-size: .88rem; font-weight: 600; }
        .foot { margin-top: 30px; text-align: center; color: var(--muted); font-size: .8rem; }
        .foot a { color: var(--red); text-decoration: none; font-weight: 600; }

        @@media (max-width: 960px) {
            .page { grid-template-columns: 1fr; }
            .hero { padding: 28px 24px 36px; }
            .hero-body { margin: 28px 0 0; }
            .features, .hero-foot { display: none; }
            .hero h1 { font-size: 1.8rem; }
            .side { padding: 28px 20px 40px; }
            .tab { flex-direction: column; gap: 4px; font-size: .78rem; padding: 8px 4px; }
        }
    </style>
</head>
<body>
    <div class="page">
        <section class="hero">
            <div class="brand"><span class="brand-mark"><i class="fa-solid fa-truck-medical"></i></span> AmbulanceWay</div>

            <div class="hero-body">
                <div class="eyebrow"><span class="dot"></span> Hệ thống điều phối hoạt động 24/7</div>
                <h1>Mỗi giây đều quý giá.<br /><span>Xe cấp cứu đến nhanh hơn.</span></h1>
                <p class="lead">Kết nối người cần cấp cứu, tài xế xe cấp cứu và bệnh viện trên cùng một bản đồ thời gian thực, rút ngắn "thời gian vàng" cho từng ca bệnh.</p>

                <div class="features">
                    <div class="feature"><i class="fa-solid fa-tower-broadcast"></i><div><b>Điều phối tức thời</b><small>Tín hiệu SOS tới các xe trong bán kính 5 km chỉ sau vài giây.</small></div></div>
                    <div class="feature"><i class="fa-solid fa-route"></i><div><b>Theo dõi trực tiếp</b><small>Người nhà thấy xe đang tới và thời gian dự kiến trên bản đồ.</small></div></div>
                    <div class="feature"><i class="fa-solid fa-hospital"></i><div><b>Kết nối bệnh viện</b><small>Chọn bệnh viện còn giường trống gần nhất ngay trên đường.</small></div></div>
                </div>
            </div>

            <div class="hero-foot">© @DateTime.Now.Year AmbulanceWay · Có ứng dụng di động cho tài xế và người dân</div>
        </section>

        <section class="side">
            <div class="card">
                <h2>Chào mừng trở lại</h2>
                <p class="sub">Chọn vai trò của bạn để tiếp tục.</p>

                <div class="tabs" role="tablist">
                    <button class="tab active" data-tab="admin" role="tab" type="button"><i class="fas fa-user-shield"></i> Quản trị</button>
                    <button class="tab" data-tab="driver" role="tab" type="button"><i class="fas fa-truck-medical"></i> Tài xế</button>
                    <button class="tab" data-tab="hospital" role="tab" type="button"><i class="fas fa-hospital"></i> Bệnh viện</button>
                    <button class="tab" data-tab="patient" role="tab" type="button"><i class="fas fa-heart-pulse"></i> Người dân</button>
                </div>

                <!-- Quản trị viên -->
                <div class="pane active" id="admin-page" data-pane="admin">
                    <div class="pane-head">
                        <div class="pane-icon" style="background: var(--admin)"><i class="fas fa-user-shield"></i></div>
                        <div><b>Trung tâm điều phối</b><small>Giám sát bản đồ, gán xe, quản lý dữ liệu</small></div>
                    </div>
                    <div class="field">
                        <label for="admin-user">Tài khoản</label>
                        <div class="input"><i class="fas fa-user"></i><input type="text" id="admin-user" placeholder="Tên đăng nhập" value="admin" autocomplete="username"></div>
                    </div>
                    <div class="field">
                        <label for="admin-pass">Mật khẩu</label>
                        <div class="input">
                            <i class="fas fa-lock"></i><input type="password" id="admin-pass" placeholder="Mật khẩu" autocomplete="current-password">
                            <button class="toggle-pass" type="button" tabindex="-1" aria-label="Hiện mật khẩu"><i class="fas fa-eye" style="position:static;transform:none"></i></button>
                        </div>
                    </div>
                    <button class="btn admin-btn" onclick="submitLogin('ADMIN')"><i class="fas fa-right-to-bracket"></i> Đăng nhập</button>
                </div>

                <!-- Tài xế -->
                <div class="pane" id="driver-page" data-pane="driver">
                    <div class="pane-head">
                        <div class="pane-icon" style="background: linear-gradient(135deg, #ff5a52, #b71c1c)"><i class="fas fa-truck-medical"></i></div>
                        <div><b>Tài xế xe cấp cứu</b><small>Vào ca trực, nhận ca và dẫn đường</small></div>
                    </div>
                    <div class="field">
                        <label for="driver-user">Tên đăng nhập</label>
                        <div class="input"><i class="fas fa-id-badge"></i><input type="text" id="driver-user" placeholder="Ví dụ: test_driver1" autocomplete="username"></div>
                    </div>
                    <div class="field">
                        <label for="driver-pass">Mật khẩu</label>
                        <div class="input">
                            <i class="fas fa-lock"></i><input type="password" id="driver-pass" placeholder="Mật khẩu" autocomplete="current-password">
                            <button class="toggle-pass" type="button" tabindex="-1" aria-label="Hiện mật khẩu"><i class="fas fa-eye" style="position:static;transform:none"></i></button>
                        </div>
                    </div>
                    <button class="btn driver-btn" onclick="submitLogin('DRIVER')"><i class="fas fa-play"></i> Bắt đầu ca trực</button>
                    <div class="hint"><i class="fas fa-mobile-screen"></i>Trên điện thoại, dùng ứng dụng AmbulanceWay để nhận SOS kèm GPS và dẫn đường.</div>
                </div>

                <!-- Bệnh viện -->
                <div class="pane" id="hospital-page" data-pane="hospital">
                    <div class="pane-head">
                        <div class="pane-icon" style="background: linear-gradient(135deg, #0ea5e9, #0369a1)"><i class="fas fa-hospital"></i></div>
                        <div><b>Cổng bệnh viện</b><small>Nhận báo bệnh nhân đang đến, cập nhật giường trống</small></div>
                    </div>
                    <div class="field">
                        <label for="hospital-user">Tài khoản bệnh viện</label>
                        <div class="input"><i class="fas fa-hospital-user"></i><input type="text" id="hospital-user" placeholder="Ví dụ: bv_choray" autocomplete="username"></div>
                    </div>
                    <div class="field">
                        <label for="hospital-pass">Mật khẩu</label>
                        <div class="input">
                            <i class="fas fa-lock"></i><input type="password" id="hospital-pass" placeholder="Mật khẩu" autocomplete="current-password">
                            <button class="toggle-pass" type="button" tabindex="-1" aria-label="Hiện mật khẩu"><i class="fas fa-eye" style="position:static;transform:none"></i></button>
                        </div>
                    </div>
                    <button class="btn hospital-btn" onclick="submitHospitalLogin()"><i class="fas fa-right-to-bracket"></i> Vào cổng tiếp nhận</button>
                    <div class="hint"><i class="fas fa-circle-info"></i>Tài khoản bệnh viện do trung tâm điều phối cấp (trang Admin → Bệnh viện → Tài khoản).</div>
                </div>

                <!-- Người dân -->
                <div class="pane" id="patient-page" data-pane="patient">
                    <div class="pane-head">
                        <div class="pane-icon" style="background: linear-gradient(135deg, #22c55e, #15803d)"><i class="fas fa-heart-pulse"></i></div>
                        <div><b>Người dân / người nhà</b><small>Khai báo hồ sơ y tế và gọi cứu trợ khẩn cấp</small></div>
                    </div>
                    <a href="/Patient/Register" class="btn patient-btn"><i class="fas fa-file-medical"></i> Đăng ký hồ sơ & gửi SOS</a>
                    <a href="/Patient/Sos" class="btn btn-ghost"><i class="fas fa-bullhorn"></i> Vào trang gửi SOS</a>
                    <div class="hint"><i class="fas fa-phone"></i>Trường hợp nguy kịch, hãy gọi ngay <b>115</b> song song với việc gửi SOS.</div>
                </div>

                <div id="msg"></div>
                @Html.AntiForgeryToken()

                <div class="foot">Gặp sự cố khi đăng nhập? Liên hệ <a href="tel:115">trung tâm điều phối</a></div>
            </div>
        </section>
    </div>

    <script>
        let activeTab = 'admin';

        function showTab(name) {
            activeTab = name;
            document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === name));
            document.querySelectorAll('.pane').forEach(p => p.classList.toggle('active', p.dataset.pane === name));
            document.getElementById('msg').innerText = '';
            const first = document.querySelector(`.pane[data-pane="${name}"] input`);
            if (first) first.focus();
        }
        document.querySelectorAll('.tab').forEach(t => t.addEventListener('click', () => showTab(t.dataset.tab)));

        // Giữ tương thích với mã cũ gọi goTo('driver-page')
        function goTo(id) { showTab(id.replace('-page', '')); }

        document.querySelectorAll('.toggle-pass').forEach(btn => btn.addEventListener('click', () => {
            const input = btn.parentElement.querySelector('input');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.querySelector('i').className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
        }));

        async function submitLogin(type) {
            const msg = document.getElementById("msg");
            let u, p;

            if (type === 'ADMIN') {
                u = document.getElementById('admin-user').value.trim();
                p = document.getElementById('admin-pass').value.trim();
            } else {
                u = document.getElementById('driver-user').value.trim();
                p = document.getElementById('driver-pass').value.trim();
            }

            if (!u || !p) {
                msg.style.color = "#dc2626";
                msg.innerText = "Vui lòng nhập đầy đủ thông tin.";
                return;
            }

            const button = document.querySelector(`.pane.active .btn`);
            if (button) button.disabled = true;
            msg.style.color = "#2563eb";
            msg.innerText = "Đang xác thực...";

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Gửi dạng x-www-form-urlencoded (khớp với AccountController.Login)
            const params = new URLSearchParams();
            params.append("username", u);
            params.append("password", p);
            params.append('type', type);
            try {
                const response = await fetch('/Account/Login', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: params
                });

                const result = await response.json();

                if (result.success) {
                    msg.style.color = "#16a34a";
                    msg.innerText = "Đăng nhập thành công, đang chuyển trang...";
                    setTimeout(() => { window.location.href = result.redirectUrl; }, 500);
                } else {
                    msg.style.color = "#dc2626";
                    msg.innerText = result.message;
                    if (button) button.disabled = false;
                }
            } catch (err) {
                msg.style.color = "#dc2626";
                msg.innerText = "Không kết nối được máy chủ.";
                if (button) button.disabled = false;
            }
        }

        // Cổng bệnh viện đăng nhập qua API riêng (bảng HospitalUsers), không qua AccountController
        async function submitHospitalLogin() {
            const msg = document.getElementById("msg");
            const u = document.getElementById("hospital-user").value.trim();
            const p = document.getElementById("hospital-pass").value.trim();
            if (!u || !p) {
                msg.style.color = "#dc2626";
                msg.innerText = "Vui lòng nhập đầy đủ thông tin.";
                return;
            }
            const button = document.querySelector(".pane.active .btn");
            if (button) button.disabled = true;
            msg.style.color = "#2563eb";
            msg.innerText = "Đang xác thực...";
            try {
                const response = await fetch("/api/HospitalPortal/login", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ Username: u, Password: p })
                });
                const result = await response.json();
                if (response.ok && result.success) {
                    msg.style.color = "#16a34a";
                    msg.innerText = "Đăng nhập thành công, đang chuyển trang...";
                    setTimeout(() => { window.location.href = result.redirectUrl || "/HospitalPortal/Dashboard"; }, 500);
                } else {
                    msg.style.color = "#dc2626";
                    msg.innerText = result.message || "Tài khoản hoặc mật khẩu không đúng";
                    if (button) button.disabled = false;
                }
            } catch (err) {
                msg.style.color = "#dc2626";
                msg.innerText = "Không kết nối được máy chủ.";
                if (button) button.disabled = false;
            }
        }

        // Nhấn Enter để đăng nhập theo tab đang mở
        document.addEventListener("keydown", (e) => {
            if (e.key !== "Enter") return;
            if (activeTab === 'admin') submitLogin('ADMIN');
            else if (activeTab === 'driver') submitLogin('DRIVER');
            else if (activeTab === 'hospital') submitHospitalLogin();
        });

        document.getElementById('admin-pass').focus();
    </script>
</body>
</html>
