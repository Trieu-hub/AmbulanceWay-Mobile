@{
    ViewData["Title"] = "Ambulance Way";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />

<style>
    body, html { margin: 0; padding: 0; height: 100%; overflow: hidden; }
    #map { position: absolute; top: 0; bottom: 0; width: 100%; z-index: 1; }

    .ui-layer { 
        position: absolute; 
        z-index: 9999 !important; 
        pointer-events: auto;
    }

    .top-right { top: 20px; right: 20px; display: flex; flex-direction: column; gap: 10px; }
    .top-left { top: 20px; left: 20px; }
    .bottom-right { bottom: 30px; right: 20px; }
    .bottom-left { bottom: 30px; left: 20px; }

    button { 
        padding: 12px 20px; 
        font-weight: bold; 
        cursor: pointer; 
        border: none; 
        border-radius: 8px; 
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .btn-main { background: #0d6efd; color: white; }
    .btn-danger { background: #dc3545; color: white; }
    .btn-success { background: #198754; color: white; }
    .btn-white { background: white; color: black; }

    #badge { 
        background: red; color: white; padding: 2px 6px; 
        border-radius: 50%; font-size: 12px; 
        position: absolute; top: -5px; right: -5px; 
    }
    
    .popup-custom {
        display: none; position: fixed; 
        top: 50%; left: 50%; transform: translate(-50%, -50%);
        background: white; padding: 25px; border-radius: 15px; 
        z-index: 10000; box-shadow: 0 0 50px rgba(0,0,0,0.5); 
        min-width: 300px; text-align: center;
    }
</style>

<div id="map"></div>

<div class="ui-layer top-left">
    <button class="btn-white" onclick="showEmergency()" style="position:relative;">
        🔔 <span id="badge">0</span>
    </button>
</div>

<div class="ui-layer top-right">
    <button class="btn-white" id="toggleTheme">🌙 Mode</button>
    <button class="btn-main" id="toggleRoute">✖ Ẩn chỉ đường</button>
    <button class="btn-danger" onclick="endShift()">🚪 Thoát ca</button>
</div>

<div class="ui-layer bottom-left">
    <button class="btn-success" onclick="completeCase()">✅ Hoàn thành ca</button>
</div>

<div class="ui-layer bottom-right">
    <button class="btn-white" id="btnLocate" 
        style="border-radius: 50%; width: 60px; height: 60px; font-size: 24px;">
        📍
    </button>
</div>

<div id="popupBox" class="popup-custom">
    <div id="popupContent"></div>
    <br>
    <button class="btn-main" onclick="closePopup()">Đóng</button>
</div>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>

<script>
    var map;
    var routingControl = null;
    var currentTripId = null;

    var emergencyCases = [
        { loc: "123 Lê Lợi, Q.1", lat: 10.780, lng: 106.700 },
        { loc: "456 Nguyễn Huệ, Q.1", lat: 10.770, lng: 106.710 }
    ];

    function showPopup(msg) {
        document.getElementById("popupContent").innerHTML = msg;
        document.getElementById("popupBox").style.display = "block";
    }

    function closePopup() {
        document.getElementById("popupBox").style.display = "none";
    }

    function showEmergency() {
        if (emergencyCases.length === 0)
            return showPopup("Hết ca cấp cứu.");

        let html = "<b>Danh sách ca:</b><br><br>";

        emergencyCases.forEach((c, i) => {
            html += `<div>${c.loc} 
                        <button onclick="acceptCase(${i})">Nhận</button>
                     </div><hr>`;
        });

        showPopup(html);
    }

    function acceptCase(i) {
        closePopup();

        const c = emergencyCases[i];

        navigator.geolocation.getCurrentPosition(async function (p) {

            if (routingControl) map.removeControl(routingControl);

            routingControl = L.Routing.control({
                waypoints: [
                    L.latLng(p.coords.latitude, p.coords.longitude),
                    L.latLng(c.lat, c.lng)
                ],
                createMarker: () => null
            }).addTo(map);

            emergencyCases.splice(i, 1);
            document.getElementById("badge").innerText = emergencyCases.length;

            currentTripId = await createTrip(p.coords.latitude, p.coords.longitude, c);
        });
    }

    async function createTrip(userLat, userLng, c) {
        try {
            const res = await fetch("/api/Trips", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    incidentAddress: c.loc,
                    incidentLat: c.lat,
                    incidentLng: c.lng,
                    hospitalAddress: "Bệnh viện gần nhất",
                    hospitalLat: userLat,
                    hospitalLng: userLng,
                    distanceKm: 0,
                    estimatedMinutes: 0
                })
            });

            const data = await res.json();
            return data.id;
        } catch {
            return null;
        }
    }

    function completeCase() {
        if (routingControl && currentTripId) {
            map.removeControl(routingControl);
            routingControl = null;

            fetch(`/api/Trips/${currentTripId}/status`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify("DONE")
            });

            showPopup("Đã hoàn thành ca 🚑");
        }
    }

    function endShift() {
        if (confirm("Thoát ca?")) {
            fetch("/Home/EndShift", { method: "POST" })
                .then(() => window.location.href = "/Account/Login");
        }
    }

    document.addEventListener("DOMContentLoaded", function () {

        var c = L.DomUtil.get('map');
        if (c != null) c._leaflet_id = null;

        map = L.map('map').setView([10.7769, 106.7009], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png')
            .addTo(map);

        document.getElementById("badge").innerText = emergencyCases.length;

        document.getElementById("btnLocate").onclick = function () {
            navigator.geolocation.getCurrentPosition(p => {
                map.setView([p.coords.latitude, p.coords.longitude], 16);
            });
        };

        document.getElementById("toggleRoute").onclick = function () {
            var panel = document.querySelector(".leaflet-routing-container");
            if (!panel) return;

            panel.style.display =
                (panel.style.display === "none") ? "block" : "none";
        };
    });
</script>
}